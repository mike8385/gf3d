# Text files (force LF endings)
*.c      text eol=lf
*.h      text eol=lf
*.cfg    text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.vert   text eol=lf
*.frag   text eol=lf
*.glsl   text eol=lf
*.md     text eol=lf

# Binary files (do not convert line endings)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.bmp    binary
*.obj    binary
*.blend  binary
*.xcf    binary
*.fbx    binary
*.wav    binary
*.ogg    binary
*.mp3    binary
